# Шаблон для боевого окружения. Скопируйте на сервере в `.env` рядом с
# infra/docker-compose.yml и ЗАПОЛНИТЕ все плейсхолдеры реальными значениями —
# сам этот файл коммитится в репозиторий БЕЗ секретов, только как чек-лист
# того, что нужно задать. См. также DEPLOY-чек-лист в чате/README.

# DATABASE (PostgreSQL 15 + pgvector)
POSTGRES_USER=medflow
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=medflow_db
POSTGRES_PORT=5432

# REDIS 7+
REDIS_PORT=6379

# OBJECT STORAGE (MinIO / S3)
# Для прод-трафика снаружи нужен домен/CDN перед MinIO — см. S3_PUBLIC_ENDPOINT
# ниже и комментарий в backend/internal/config/config.go (S3Config.PublicEndpoint).
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_random_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_NAME=medflow-assets
S3_REGION=ru-central1
# Домен/CDN, по которому presigned-ссылки реально достижимы для браузера
# клиента (не внутренний docker-хост minio:9000). Обязательно поменять —
# по умолчанию backend подставит localhost, что не работает для внешних юзеров.
S3_PUBLIC_ENDPOINT=s3.your-domain.ru

# EMAIL
# ВНИМАНИЕ: сейчас SMTP_HOST захардкожен на "mailhog" прямо в
# infra/docker-compose.yml (services.backend/worker.environment), а
# Username/Password/From у EmailConfig в backend/internal/config/config.go
# вообще не читаются из env. Значения ниже НЕ заработают сами по себе —
# сначала нужна правка кода (см. чек-лист), потом уже реальный SMTP.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# APPLICATION (Backend Go)
# production — критично: отключает автосоздание тестовых юзеров в cmd/seed
# (см. backend/cmd/seed/main.go) и должен использоваться именно это значение,
# не "local"/"prod"/что угодно ещё.
APP_ENV=production
APP_PORT=8080
APP_HOST=0.0.0.0

# Email(-а) через запятую, которым при регистрации присваивается role=admin
# (см. AuthService.isAdminEmail в backend/internal/service/auth_service.go).
# Без этого в проде НЕТ другого способа завести первого админа — seed
# отключён по APP_ENV=production. Задайте до первой регистрации админа,
# затем можно убрать/сузить.
ADMIN_EMAILS=admin@your-domain.ru

# JWT — сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_random_48_bytes_base64
JWT_REFRESH_SECRET=CHANGE_ME_random_48_bytes_base64
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=720h

# VAPID (Web Push) — сгенерировать один раз и больше не менять (иначе у всех
# существующих push-подписок отвалится доставка):
#   go run -exec "" -e 'package main; ...' или через
#   github.com/SherClockHolmes/webpush-go.GenerateVAPIDKeys()
VAPID_PUBLIC_KEY=CHANGE_ME_generated_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_generated_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.ru

# Навигатор (карта): бесплатный ключ на developer.tech.yandex.ru (JS API).
YANDEX_MAPS_API_KEY=CHANGE_ME

# AI / LLM — боевой провайдер и реальный ключ (не заглушка).
LLM_API_KEY=CHANGE_ME
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Ollama — эмбеддинги карточек всегда идут через него, независимо от LLM_PROVIDER
# (см. backend/internal/pkg/llm/llm.go). Контейнер `ollama` (профиль "ai" в
# infra/docker-compose.yml) должен быть постоянно поднят — без него генерация
# карточек будет падать на этапе эмбеддинга. Если Ollama крутится не в этом
# docker-compose (отдельный сервер/GPU-хост), укажите его реальный адрес.
OLLAMA_HOST=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3

# Frontend URL — реальный домен, используется для CORS.
FRONTEND_URL=https://your-domain.ru

# INFRA (docker-compose)
# Домен вместо голого порта — тогда Caddy сам заберёт сертификат Let's
# Encrypt (см. infra/Caddyfile, HTTP_PORT там менять не нужно, домен
# прописывается прямо в Caddyfile).
HTTP_PORT=80

# MONITORING (профиль monitoring, опционально)
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
