# DATABASE (PostgreSQL 15 + pgvector)
POSTGRES_USER=medflow
POSTGRES_PASSWORD=medflow_secret
POSTGRES_DB=medflow_db
POSTGRES_PORT=5433

# REDIS 7+
REDIS_PORT=6380

# OBJECT STORAGE (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_NAME=medflow-assets
S3_REGION=ru-central1

# EMAIL (Mailhog для тестирования)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# APPLICATION (Backend Go)
APP_ENV=local
APP_PORT=8080
APP_HOST=localhost

# JWT Configuration
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=720h

# VAPID (Web Push) — сгенерировано локально для dev, сменить перед продом.
VAPID_PUBLIC_KEY=BFtgxD10ToK6LdT4harjm_2PF3f3bgcz_pQ9FNVLKFfRpOW17I--LkkKI1f0cx5OuCHHeF6fXptHWml-Ds0naSA
VAPID_PRIVATE_KEY=kScEoKeULTPrJ2NeiA1GSD8yl2yw7Kr0xyUEbR5_3Hs
VAPID_SUBJECT=mailto:admin@medflow.local

# Навигатор (карта): бесплатный ключ на developer.tech.yandex.ru (JS API).
YANDEX_MAPS_API_KEY=

# AI / LLM
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# Не используется: у облачных провайдеров нет единого рабочего контракта на
# эмбеддинги — они всегда идут через Ollama, см. backend/internal/pkg/llm.
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Ollama — эмбеддинги карточек всегда идут через него, независимо от LLM_PROVIDER
# (см. backend/internal/pkg/llm/llm.go). Поднят как контейнер `ollama` (профиль
# "ai", см. infra/docker-compose.yml) — отсюда host по имени сервиса в сети compose.
# Для нативной Ollama на хосте (macOS, GPU) верните http://host.docker.internal:11434.
OLLAMA_HOST=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3

# Frontend URL (для настройки CORS)
FRONTEND_URL=http://localhost:5173

# INFRA (docker-compose)
HTTP_PORT=8081

# MONITORING (профиль monitoring)
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin