# Backend API. В docker-compose проксируется через caddy на /api/v1.
VITE_API_URL=http://localhost:8080/api/v1

# API-first разработка: пока backend не реализовал модуль — включены моки MSW
# поверх контракта backend/docs/openapi.yaml. Выключить, когда бэкенд догонит.
VITE_USE_MOCKS=true

# Навигатор (карта): бесплатный ключ на developer.tech.yandex.ru (JS API).
# Без ключа страница /navigator покажет заглушку вместо карты.
VITE_YANDEX_MAPS_API_KEY=
