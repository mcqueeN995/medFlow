# DATABASE (PostgreSQL 15 + pgvector)
POSTGRES_USER=medflow
POSTGRES_PASSWORD=medflow_secret
POSTGRES_DB=medflow_db
POSTGRES_PORT=5432

# REDIS 7+
REDIS_PORT=6379

# OBJECT STORAGE (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_NAME=medflow-assets
S3_REGION=ru-central1

# EMAIL (Mailhog для тестирования)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# APPLICATION (Backend Go)
APP_ENV=local
APP_PORT=8080
APP_HOST=localhost

# JWT Configuration
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=720h

# VAPID (Web Push, см. PWA-полировка) — сгенерировать один раз через
# `go run` с github.com/SherClockHolmes/webpush-go.GenerateVAPIDKeys(),
# публичный ключ не секрет (он же уходит на фронт как VITE_VAPID_PUBLIC_KEY
# в infra/docker-compose.yml), приватный — секрет, менять перед продом.
VAPID_PUBLIC_KEY=change_me_generated_vapid_public_key
VAPID_PRIVATE_KEY=change_me_generated_vapid_private_key
VAPID_SUBJECT=mailto:admin@medflow.local

# AI / LLM
# Прод по умолчанию: облачный провайдер (deepseek/qwen/openrouter).
# Локальная разработка: LLM_PROVIDER=ollama — модели тянутся через `ollama pull`,
# сервис поднимается нативно на хосте или через `--profile ai` в docker-compose.
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# Не используется: у облачных провайдеров (deepseek/qwen/openrouter) нет единого
# рабочего контракта на эмбеддинги (у openrouter эмбеддингов нет вовсе), поэтому
# Provider.Embed у облачного провайдера всегда возвращает ErrEmbedNotSupported —
# эмбеддинги всегда идут через Ollama (OLLAMA_EMBEDDING_MODEL), см. backend/internal/pkg/llm.
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Ollama — эмбеддинги карточек всегда идут через него, независимо от LLM_PROVIDER
# (см. backend/internal/pkg/llm/llm.go). http://host.docker.internal:11434 — для
# нативной Ollama на хосте (macOS/GPU); для контейнера `ollama` (--profile ai)
# используйте http://ollama:11434.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3

# Frontend URL (для настройки CORS)
FRONTEND_URL=http://localhost:5173

# INFRA (docker-compose)
# Порт, на котором Caddy слушает весь стек (frontend + /api проксируются через него).
HTTP_PORT=80

# MONITORING (профиль monitoring: `docker compose --profile monitoring up -d`,
# или `make up-monitoring`) — Prometheus/Grafana/Pushgateway, метрики backend
# и результаты тестовых прогонов (см. frontend/scripts/push-test-metrics.mjs).
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin